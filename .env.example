# Copy to .env.local (development) or set in your hosting provider (production).
# Never commit real values.

# --- SEO ---------------------------------------------------------------------
# Canonical origin used for canonical URLs, sitemap, robots, Open Graph and
# structured data. Defaults to https://www.folacreativeagency.com when empty, so
# production needs nothing here. Only set it for a separate staging host.
NEXT_PUBLIC_SITE_URL=

# Set to "false" on any non-production deployment to serve a robots.txt that
# blocks all crawling. Vercel preview deployments are blocked automatically.
ALLOW_INDEXING=

# Optional search-engine ownership tokens (HTML-tag method). Paste only the
# content="..." value. Leave empty if you verify the domain through DNS instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Contact form delivery (Resend, https://resend.com) ---------------------
# When RESEND_API_KEY or CONTACT_TO_EMAIL is empty, the form does NOT pretend to
# send: it tells the visitor and offers a pre-filled email instead.

# Server-only API key from the Resend dashboard.
RESEND_API_KEY=

# Inbox that receives enquiries.
CONTACT_TO_EMAIL=

# Sender shown on enquiry emails. Must be on a domain verified in Resend.
# Defaults to "FCA Website <onboarding@resend.dev>" (Resend test sender, which
# can only deliver to the Resend account owner's address).
CONTACT_FROM_EMAIL=
