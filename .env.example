# Copy to .env.local (development) or set in your hosting provider (production).
# Never commit real values.

# Public URL of the deployed site, used for canonical URLs, sitemap, robots and
# Open Graph. Example: https://www.example.com  (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# --- Contact form delivery (Resend, https://resend.com) ---------------------
# When RESEND_API_KEY or CONTACT_TO_EMAIL is empty, the form does NOT pretend to
# send: it tells the visitor and offers a pre-filled email instead.

# Server-only API key from the Resend dashboard.
RESEND_API_KEY=

# Inbox that receives enquiries.
CONTACT_TO_EMAIL=

# Sender shown on enquiry emails. Must be on a domain verified in Resend.
# Defaults to "FCA Website <onboarding@resend.dev>" (Resend test sender, which
# can only deliver to the Resend account owner's address).
CONTACT_FROM_EMAIL=
